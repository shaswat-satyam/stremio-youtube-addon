<div id="<%= dom_id episode %>">
  <div>
    <strong>Season:</strong>
    <%= episode.season_id %>
  </div>

  <div>
    <strong>Imdb:</strong>
    <%= episode.imdb_id %>
  </div>

  <div>
    <strong>Episode number:</strong>
    <%= episode.episode_number %>
  </div>

  <div>
    <strong>Youtube link:</strong>
    <%= episode.youtube_link %>
  </div>

  <div>
    <strong>Is embeddable:</strong>
    <%= episode.is_embeddable %>
  </div>

</div>
