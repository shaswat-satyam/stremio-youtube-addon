<% content_for :title, "StreamVault — Home" %>

<style>
  .home-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .home-hero h1 {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -1px;
    margin-bottom: 0.5rem;
  }

  .home-hero h1 span {
    color: #e50914;
  }

  .home-hero p {
    color: #888;
    font-size: 1.1rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 2.5rem 0 1rem;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .section-title span {
    color: #e50914;
  }

  .view-all {
    color: #888;
    text-decoration: none;
    font-size: 0.85rem;
    border: 1px solid #333;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .view-all:hover {
    color: #fff;
    border-color: #555;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  .card {
    background: #111;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #1a1a1a;
    transition: transform 0.2s, border-color 0.2s;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: #e50914;
  }

  .card-poster {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    background: #1a1a1a;
    display: block;
  }

  .card-poster-placeholder {
    width: 100%;
    aspect-ratio: 2/3;
    background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .card-body {
    padding: 0.6rem 0.75rem 0.75rem;
  }

  .card-title {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.25rem;
  }

  .card-meta {
    font-size: 0.75rem;
    color: #666;
  }

  .badge {
    display: inline-block;
    font-size: 0.65rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badge-movie { background: #1a237e; color: #90caf9; }
  .badge-series { background: #1b5e20; color: #a5d6a7; }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: #444;
    border: 1px dashed #222;
    border-radius: 8px;
  }

  .stats-bar {
    display: flex;
    gap: 1.5rem;
    background: #111;
    border: 1px solid #1a1a1a;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .stat { text-align: center; }
  .stat-number { font-size: 1.8rem; font-weight: 700; color: #e50914; }
  .stat-label { font-size: 0.75rem; color: #666; text-transform: uppercase; letter-spacing: 1px; }
</style>

<div class="home-hero">
  <h1>Stream<span>Vault</span></h1>
  <p>Your personal YouTube media library</p>
</div>

<div class="stats-bar">
  <div class="stat">
    <div class="stat-number"><%= @movies.count %></div>
    <div class="stat-label">Movies</div>
  </div>
  <div class="stat">
    <div class="stat-number"><%= @shows.count %></div>
    <div class="stat-label">Shows</div>
  </div>
  <div class="stat">
    <div class="stat-number"><%= @movies.count + @shows.count %></div>
    <div class="stat-label">Total</div>
  </div>
</div>

<%# Movies Section %>
<div class="section-header">
  <h2 class="section-title">🎬 <span>Movies</span></h2>
  <%= link_to "View all →", movies_path, class: "view-all" %>
</div>

<% if @movies.any? %>
  <div class="grid">
    <% @movies.each do |movie| %>
      <%= link_to movie_path(movie), class: "card" do %>
        <% if movie.poster_url.present? %>
          <img src="<%= movie.poster_url %>" alt="<%= movie.title %>" class="card-poster" loading="lazy">
        <% else %>
          <div class="card-poster-placeholder">🎬</div>
        <% end %>
        <div class="card-body">
          <div class="card-title"><%= movie.title.presence || movie.imdb_id %></div>
          <div class="card-meta">
            <span class="badge badge-movie">Movie</span>
            <% if movie.is_embeddable? %>
              &nbsp;✓ Embeddable
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>No movies yet. <%= link_to "Add one →", new_movie_path, style: "color: #e50914" %></p>
  </div>
<% end %>

<%# Shows Section %>
<div class="section-header">
  <h2 class="section-title">📺 <span>Shows</span></h2>
  <%= link_to "View all →", shows_path, class: "view-all" %>
</div>

<% if @shows.any? %>
  <div class="grid">
    <% @shows.each do |show| %>
      <%= link_to show_path(show), class: "card" do %>
        <% if show.poster_url.present? %>
          <img src="<%= show.poster_url %>" alt="<%= show.title %>" class="card-poster" loading="lazy">
        <% else %>
          <div class="card-poster-placeholder">📺</div>
        <% end %>
        <div class="card-body">
          <div class="card-title"><%= show.title.presence || show.imdb_id %></div>
          <div class="card-meta">
            <span class="badge badge-series">Series</span>
            &nbsp;<%= show.seasons.count %> season(s)
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>No shows yet. <%= link_to "Add one →", new_show_path, style: "color: #e50914" %></p>
  </div>
<% end %>

