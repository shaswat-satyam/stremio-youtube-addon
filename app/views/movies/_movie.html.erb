<div id="<%= dom_id movie %>">
  <div>
    <strong>Title:</strong>
    <%= movie.title %>
  </div>

  <div>
    <strong>Imdb:</strong>
    <%= movie.imdb_id %>
  </div>

  <div>
    <strong>Youtube link:</strong>
    <%= movie.youtube_link %>
  </div>

  <div>
    <strong>Is embeddable:</strong>
    <%= movie.is_embeddable %>
  </div>

</div>
